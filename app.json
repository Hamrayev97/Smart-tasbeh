{
  "expo": {
    "name": "Smart Tasbeh",
    "slug": "aqilli-tasbeh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A3D0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hamrayev97.smarttasbeh",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A3D0A"
      },
      "package": "com.hamrayev97.smarttasbeh",
      "versionCode": 1,
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b276b922-89c2-4d62-a8b0-473e6abcb4fe"
      }
    },
    "owner": "hamrayev97",
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "react-native-iap",
        {
          "paymentProvider": "Play Store"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Smart Tasbeh needs your location to calculate accurate prayer times and Qibla direction."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A3D0A"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TasbehCounter",
              "label": "Smart Tasbeh",
              "description": "Dhikr counter widget",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ]
  }
}